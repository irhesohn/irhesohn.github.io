---
import '../styles/global.css';
import { site } from '../site';
import { ui, href, other, titleText, type Lang } from '../i18n';

interface Props { lang: Lang; path?: string; title?: string; description?: string; altHref?: string }
const { lang, path = '', title, description, altHref } = Astro.props;
const t = ui[lang];
const s = site[lang];
const section = path.split('/')[0];
const menu = [['research', t.research], ['teaching', t.teaching], ['writing', t.writing], ['about', t.about]] as const;
const alt = altHref ?? href(other(lang), path);
const enHref = lang === 'en' ? href('en', path) : alt;
const koHref = lang === 'ko' ? href('ko', path) : alt;
const name = lang === 'ko' ? site.nameKo : site.name;
const pageTitle = title ? `${titleText(title)} — ${name}` : name;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? s.intro} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Inter:wght@400;500&family=Noto+Sans+KR:wght@400;500&family=Noto+Serif+KR:wght@400;500;600&display=swap" />
  </head>
  <body>
    <div class="wrap">
      <header class="nav">
        <a class="name" href={href(lang)}>{name}</a>
        <nav class="links">
          {menu.map(([p, label]) => <a href={href(lang, p)} aria-current={section === p ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="lang">
          <a href={enHref} lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>{' · '}<a href={koHref} lang="ko" aria-current={lang === 'ko' ? 'true' : undefined}>한국어</a>
        </div>
      </header>

      <main><slot /></main>

      <footer class="foot">
        <div class="cols">
          <div class="id">
            <strong>{name}</strong>
            <span>{s.affiliation[0]}<br />{s.affiliation[1]}</span>
          </div>
          <div>
            <div class="tag">{t.site}</div>
            <ul>{menu.map(([p, label]) => <li><a href={href(lang, p)}>{label}</a></li>)}</ul>
          </div>
          <div>
            <div class="tag">{t.contact}</div>
            <ul>
              <li><a href={`mailto:${site.email}`}>{t.email}</a></li>
            </ul>
          </div>
        </div>
        <div class="bottom">
          <span class="copy">
            © {new Date().getFullYear()} {name}
            <a class="cat-link" href={href(lang, 'geumtaek')} title="금택 Geumtaek" aria-label="금택 Geumtaek (2009–2023)">
              <!-- Lucide "cat" icon, ISC License -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5c.67 0 1.35.09 2 .26 1.78-2 5.03-2.84 6.42-2.26 1.4.58-.42 7-.42 7 .57 1.07 1 2.24 1 3.44C21 17.9 16.97 21 12 21s-9-3-9-7.56c0-1.25.5-2.4 1-3.44 0 0-1.89-6.42-.5-7 1.39-.58 4.72.23 6.5 2.23A9.04 9.04 0 0 1 12 5Z"/><path d="M8 14v.5"/><path d="M16 14v.5"/><path d="M11.25 16.25h1.5L12 17l-.75-.75Z"/></svg>
            </a>
          </span>
          <span><a href={enHref} lang="en">English</a> · <a href={koHref} lang="ko">한국어</a></span>
        </div>
      </footer>
    </div>
  </body>
</html>
